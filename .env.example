# InternTrack environment. Copy to .env and fill in real values. The real .env is gitignored.

# Required for AI features (free key: https://console.groq.com/keys).
# Without it the agents fall back to rule-based logic and the UI labels the output "offline".
GROQ_API_KEY=

# Optional model overrides (defaults shown)
# GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b

# Optional: more internship sources (Indian listings)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JSEARCH_API_KEY=

# Optional switches
# PORTAL_SCHEDULER=1          # background sweep every PORTAL_SCHEDULER_MINUTES (default 30)
# PORTAL_MCP=1                # 0 = call tools in-process instead of over MCP
